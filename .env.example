# Interfaccia amministrativa, accessibile solo dalla Raspberry
HOST=127.0.0.1
PORT=3000

# API HTTPS per i lettori NFC. Installa un certificato valido/trusted sulla Raspberry.
READER_API_HOST=0.0.0.0
READER_API_PORT=3443
TLS_CERT_FILE=/etc/pragma/tls/reader-api.crt
TLS_KEY_FILE=/etc/pragma/tls/reader-api.key

# Imposta il fuso orario corretto per le regole e le fasce d'accesso.
TZ=Europe/Rome
